<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Hexagonal Glow / Shield (within 66dp center safe zone: 21 to 87) -->
    <path
        android:pathData="M54,23 L83,37 L83,69 L54,85 L25,69 L25,37 Z"
        android:strokeWidth="2"
        android:strokeColor="#00E5FF">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="25"
                android:startY="23"
                android:endX="83"
                android:endY="85"
                android:type="linear">
                <item android:color="#1A2744" android:offset="0.0" />
                <item android:color="#0D1B2A" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Golden Accent Ring -->
    <path
        android:pathData="M54,28 L78,40 L78,66 L54,79 L30,66 L30,40 Z"
        android:strokeWidth="1"
        android:strokeColor="#F59E0B"
        android:fillColor="#00000000" />

    <!-- Telegram Paper Plane Vector in Cyan / White -->
    <path
        android:pathData="M38,53 L68,39 L62,67 L53,58 L46,62 L48,55 Z"
        android:strokeWidth="1"
        android:strokeColor="#FFFFFF">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="38"
                android:startY="39"
                android:endX="68"
                android:endY="67"
                android:type="linear">
                <item android:color="#00E5FF" android:offset="0.0" />
                <item android:color="#38BDF8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Star / Crown Accent at top -->
    <path
        android:pathData="M54,32 L56,36 L60,36 L57,39 L58,43 L54,40 L50,43 L51,39 L48,36 L52,36 Z"
        android:fillColor="#FBBF24" />
</vector>
